r-32 in a `HashMap`, although"},{"DocComment":" that is not recommended (while every checksum is a hash function, they are not necessarily a"},{"DocComment":" good one)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic, piecewise checksum calculation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use adler2::Adler32;"},{"DocComment":""},{"DocComment":" let mut adler = Adler32::new();"},{"DocComment":""},{"DocComment":" adler.write_slice(&[0, 1, 2]);"},{"DocComment":" adler.write_slice(&[3, 4, 5]);"},{"DocComment":""},{"DocComment":" assert_eq!(adler.checksum(), 0x00290010);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `Hash` to process structures:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::Hash;"},{"DocComment":" use adler2::Adler32;"},{"DocComment":""},{"DocComment":" #[derive(Hash)]"},{"DocComment":" struct Data {"},{"DocComment":"     byte: u8,"},{"DocComment":"     word: u16,"},{"DocComment":"     big: u64,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut adler = Adler32::new();"},{"DocComment":""},{"DocComment":" let data = Data { byte: 0x1F, word: 0xABCD, big: !0 };"},{"DocComment":" data.hash(&mut adler);"},{"DocComment":""},{"DocComment":" // hash value depends on architecture endianness"},{"DocComment":" if cfg!(target_endian = \"little\") {"},{"DocComment":"     assert_eq!(adler.checksum(), 0x33410990);"},{"DocComment":" }"},{"DocComment":" if cfg!(target_endian = \"big\") {"},{"DocComment":"     assert_eq!(adler.checksum(), 0x331F0990);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`new`]: #method.new"},{"DocComment":" [`from_checksum`]: #method.from_checksum"},{"DocComment":" [`checksum`]: #method.checksum"}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"g