{"extractor_revision":"5d6b812e5f77dbf3d7f66c21b9b57091f0e084cb","compiler_commit":"923c95cdf5ba65cea505aa2ea829f578e1506ed8","profile":"click-charon-optimized-abort-checked-v1","flags":["--edition=2024","--target=x86_64-unknown-linux-gnu","-Cpanic=abort","-Coverflow-checks=on","-Zmir-opt-level=0"],"data":{"charon_version":"0.1.279","translated":{"crate_name":"click_charon_trial","options":{"ullbc":true,"precise_drops":true,"mir":"Optimized","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":["core","alloc","std"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":[],"hide_marker_traits":false,"hide_allocator":false,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":false,"remove_adt_clauses":false,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":false,"index_to_function_calls":false,"treat_box_as_builtin":false,"no_gen_tuple_structs":false,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":false,"reconstruct_asserts":false,"reconstruct_matches":false,"deallocate_all_locals":false,"unbind_item_vars":false,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"/tmp/.tmpuMdiv1/trial.ullbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":true,"preset":null},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"/workspace/click-rust-chunks/design/charon-trial/conversions-arrays/arrays.rs"},"crate_name":"click_charon_trial","contents":"pub struct Guard<'a> {\n    pub slot: &'a mut i32,\n    pub saved: i32,\n}\nimpl Drop for Guard<'_> {\n    fn drop(&mut self) {\n        *self.slot = self.saved;\n    }\n}\npub fn guarded_array(value: &mut i32, x: u16) -> u32 {\n    let saved = *value;\n    let guard = Guard { slot: value, saved };\n    *guard.slot = 7;\n    let lanes = [u32::from(x); 4];\n    let copy = lanes;\n    copy[3]\n}\npub fn large_array() -> u8 {\n    let bytes = [7u8; 1_000_000];\n    let copy = bytes;\n    copy[999_999]\n}\npub fn increment(value: &mut i32) -> u8 {\n    *value += 1;\n    7\n}\npub fn empty_array(value: &mut i32) {\n    let bytes = [increment(value); 0];\n    let _copy = bytes;\n}\npub fn explicit_array() -> u32 {\n    let mut values = [1u32, 2, 3];\n    values[1] = 9;\n    values[1]\n}\npub fn cast_array(x: u32) -> u8 {\n    let bytes = [x as u8; 1];\n    bytes[0]\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/ops/drop.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/pin.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Type":1},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["Guard",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["click_charon_trial",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":0},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["guarded_array",0]}]},{"key":{"Fun":1},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["large_array",0]}]},{"key":{"Fun":2},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["increment",0]}]},{"key":{"Fun":3},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["empty_array",0]}]},{"key":{"Fun":4},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["explicit_array",0]}]},{"key":{"Fun":5},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["cast_array",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["drop",0]},{"Ident":["Drop",0]}]},{"key":{"Type":2},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["drop",0]},{"Ident":["Drop",0]},{"Builtin":["VTable",0]}]},{"key":{"Global":0},"value":[{"Ident":["click_charon_trial",0]},{"Impl":{"Trait":0}},{"Builtin":["VTable",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Iden