int64 FeeFrac::EvaluateFee<true>(int32 at_size) const {
    views this->fee;
    views this->size;
    requires this->fee >= 0i64;
    requires this->fee < 8589934592i64;
    requires 0 <= to_integer(this->fee);
    requires to_integer(this->fee) <= 8589934591;
    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires to_integer(this->fee) * to_integer(at_size) < 9223372036854775808 * to_integer(this->size);
    requires this->size > 0;
    requires this->size <= 2147483647;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures 0 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures to_integer(result) * to_integer(this->size) <= to_integer(this->fee) * to_integer(at_size);
    ensures to_integer(this->fee) * to_integer(at_size) < (to_integer(result) + 1) * to_integer(this->size);
    ensures to_integer(result) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size));
} by {
    have 1 <= this->size by {
        apply(integer::lt_step_le(0, to_integer(this->size)));
        close();
    }
    have to_integer(this->fee as uint64) == to_integer(this->fee) by {
        apply(fee_to_uint64(this->fee));
    }
    have to_integer(at_size as uint64) == to_integer(at_size) by {
        apply(amount_to_uint64(at_size));
    }
    have to_integer(this->size as uint32) == to_integer(this->size) by {
        apply(size_to_uint32(this->size));
    }
    have 1 <= to_integer(this->size as uint32) by { rewrite(to_integer(this->size as uint32), to_integer(this->size)); close(); }
    have to_integer(this->size as uint32) <= 2147483647 by { rewrite(to_integer(this->size as uint32), to_integer(this->size)); close(); }
    have to_integer(this->size as uint32 as uint64) == to_integer(this->size as uint32) by {
        apply(size_to_uint64(this->size as uint32));
    }
    have to_integer(this->size as uint32 as uint64) == to_integer(this->size) by {
        rewrite(to_integer(this->size as uint32 as uint64), to_integer(this->size as uint32));
        close();
    }
    have to_integer(this->size) != 0 by {
        close() using { 1 <= to_integer(this->size); };
    }
    have to_integer(this->size as uint32 as uint64) != 0 by { rewrite(to_integer(this->size as uint32 as uint64), to_integer(this->size)); close(); }
    have 1 <= to_integer(this->size as uint32 as uint64) by { rewrite(to_integer(this->size as uint32 as uint64), to_integer(this->size)); close(); }
    have not (to_integer(this->size as uint32 as uint64) == 0) by { close() using { 1 <= to_integer(this->size as uint32 as uint64); }; }
    have this->size as uint32 as uint64 != 0u64 by { if this->size as uint32 as uint64 == 0u64 {
        have to_integer(this->size as uint32 as uint64) == 0 by { rewrite(this->size as uint32 as uint64, 0u64); close(); }
        close();
    } else { close(); } }
    have 0 <= to_integer(this->fee) * to_integer(at_size) by {
        apply(integer::product_lower_bound(
            to_integer(this->fee), to_integer(at_size), 0, 8589934591, 0, 2147483647, 0));
    }
    have to_integer(this->fee) * to_integer(at_size) <= 18446744062972133377 by {
        apply(integer::product_upper_bound(
            to_integer(this->fee), to_integer(at_size), 0, 8589934591, 0, 2147483647, 18446744062972133377));
    }
    have to_integer(this->fee) * to_integer(at_size) <= 18446744073709551615 by { close() using { to_integer(this->fee) * to_integer(at_size) <= 18446744062972133377; } }
    have to_integer(this->fee as uint64) * to_integer(at_size as uint64) <= 18446744073709551615 by {
        rewrite(to_integer(this->fee as uint64), to_integer(this->fee));
        rewrite(to_integer(at_size as uint64), to_integer(at_size));
        close();
    }
    apply(integer::uint64_multiply_to_integer(this->fee as uint64, at_size as uint64));
    have to_integer((this->fee as uint64 * at_size as uint64)) == to_integer(this->fee) * to_integer(at_size) by {
        rewrite(to_integer((this->fee as uint64 * at_size as uint64)), to_integer(this->fee as uint64) * to_integer(at_size as uint64));
        rewrite(to_integer(this->fee as uint64), to_integer(this->fee));
        rewrite(to_integer(at_size as uint64), to_integer(at_size));
        close();
    }
    apply(integer::uint64_divide_to_integer((this->fee as uint64 * at_size as uint64), this->size as uint32 as uint64));
    have to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) by {
        rewrite(to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)), truncating_quotient(to_integer((this->fee as uint64 * at_size as uint64)), to_integer(this->size as uint32 as uint64)));
        rewrite(to_integer((this->fee as uint64 * at_size as uint64)), to_integer(this->fee) * to_integer(at_size));
        rewrite(to_integer(this->size as uint32 as uint64), to_integer(this->size));
        close();
    }
    apply(integer::positive_divisor_quotient_lower(to_integer(this->fee) * to_integer(at_size), to_integer(this->size), 0));
    apply(integer::positive_divisor_quotient_strict_upper(to_integer(this->fee) * to_integer(at_size), to_integer(this->size), 9223372036854775808));
    have truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) <= 9223372036854775807 by {
        close() using { truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) < 9223372036854775808; }
    }
    have 0 <= to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)) by {
        rewrite(to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)), truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
        close();
    }
    have to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)) <= 9223372036854775807 by {
        rewrite(to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)), truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
        close() using { truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) <= 9223372036854775807;
        }
    }
    have 0 < to_integer(this->size) by { close() using { 1 <= to_integer(this->size); } }
    apply(integer::truncation_identity(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
    apply(integer::positive_divisor_remainder_upper(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
    apply(integer::nonnegative_dividend_remainder(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
    have truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) * to_integer(this->size) <= to_integer(this->fee) * to_integer(at_size) by {
        close() using {
            to_integer(this->fee) * to_integer(at_size) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) * to_integer(this->size) + truncating_remainder(to_integer(this->fee) * to_integer(at_size), to_integer(this->size));
            0 <= truncating_remainder(to_integer(this->fee) * to_integer(at_size), to_integer(this->size));
        }
    }
    apply(integer::multiply_add(truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)), 1, to_integer(this->size)));
    have to_integer(this->fee) * to_integer(at_size) < (truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) + 1) * to_integer(this->size) by {
        rewrite((truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) + 1) * to_integer(this->size), truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) * to_integer(this->size) + 1 * to_integer(this->size));
        close() using {
            to_integer(this->fee) * to_integer(at_size) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) * to_integer(this->size) + truncating_remainder(to_integer(this->fee) * to_integer(at_size), to_integer(this->size));
            truncating_remainder(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) <= to_integer(this->size) - 1;
        }
    }
    step_until(function.exit);
    have to_integer(result) == to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)) by {
        apply(fee_result_to_int64(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)));
    }
    have to_integer(result) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)) by {
        rewrite(to_integer(result), to_integer(((this->fee as uint64 * at_size as uint64) / this->size as uint32 as uint64)));
        close();
    }
    have 0 <= to_integer(result) by {
        rewrite(to_integer(result), truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
        close();
    }
    have to_integer(result) <= 9223372036854775807 by {
        rewrite(to_integer(result), truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
        close();
    }
    have to_integer(result) * to_integer(this->size) <= to_integer(this->fee) * to_integer(at_size) by {
        rewrite(to_integer(result), truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
        close();
    }
    have to_integer(this->fee) * to_integer(at_size) < (to_integer(result) + 1) * to_integer(this->size) by {
        rewrite(to_integer(result), truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size)));
        close();
    }
    close();
}

int64 FeeFrac::EvaluateFeeDown(int32 at_size) const {
    views this->fee;
    views this->size;
    requires this->fee >= 0i64;
    requires this->fee < 8589934592i64;
    requires 0 <= to_integer(this->fee);
    requires to_integer(this->fee) <= 8589934591;
    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires to_integer(this->fee) * to_integer(at_size) < 9223372036854775808 * to_integer(this->size);
    requires this->size > 0;
    requires this->size <= 2147483647;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures 0 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures to_integer(result) * to_integer(this->size) <= to_integer(this->fee) * to_integer(at_size);
    ensures to_integer(this->fee) * to_integer(at_size) < (to_integer(result) + 1) * to_integer(this->size);
    ensures to_integer(result) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size));
}

contract int64 FastOversizeFee(const struct FeeFrac* this, int32 at_size) {
    requires this->fee == 7i64;
    requires this->size == 1;
    requires at_size == 2;
    views this->fee;
    views this->size;
    requires this->fee >= 0i64;
    requires this->fee < 8589934592i64;
    requires 0 <= to_integer(this->fee);
    requires to_integer(this->fee) <= 8589934591;
    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires to_integer(this->fee) * to_integer(at_size) < 9223372036854775808 * to_integer(this->size);
    requires this->size > 0;
    requires this->size <= 2147483647;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures 0 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures to_integer(result) * to_integer(this->size) <= to_integer(this->fee) * to_integer(at_size);
    ensures to_integer(this->fee) * to_integer(at_size) < (to_integer(result) + 1) * to_integer(this->size);
    ensures to_integer(result) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size));
}
theorem fastoversizefee_evaluation() executes FeeFrac::EvaluateFeeDown(const struct FeeFrac* this, int32 at_size) {
    ensures FastOversizeFee(&FeeFrac::EvaluateFeeDown) by { step_until(function.exit); close(); }
}

contract int64 FastLargeFee(const struct FeeFrac* this, int32 at_size) {
    requires this->fee == 8589934591i64;
    requires this->size == 2;
    requires at_size == 2147483647;
    views this->fee;
    views this->size;
    requires this->fee >= 0i64;
    requires this->fee < 8589934592i64;
    requires 0 <= to_integer(this->fee);
    requires to_integer(this->fee) <= 8589934591;
    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires to_integer(this->fee) * to_integer(at_size) < 9223372036854775808 * to_integer(this->size);
    requires this->size > 0;
    requires this->size <= 2147483647;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures 0 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures to_integer(result) * to_integer(this->size) <= to_integer(this->fee) * to_integer(at_size);
    ensures to_integer(this->fee) * to_integer(at_size) < (to_integer(result) + 1) * to_integer(this->size);
    ensures to_integer(result) == truncating_quotient(to_integer(this->fee) * to_integer(at_size), to_integer(this->size));
}
theorem fastlargefee_evaluation() executes FeeFrac::EvaluateFeeDown(const struct FeeFrac* this, int32 at_size) {
    ensures FastLargeFee(&FeeFrac::EvaluateFeeDown) by { step_until(function.exit); close(); }
}
